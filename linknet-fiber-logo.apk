MANIFEST.MF
Manifest-Version: 1.0
Created-By: Linknet Fiber
Application-Label: Linknet Fiber
Package-Name: com.linknet.fiber
Version-Code: 1
Application-Icon: icon-192.png
Application-Activity: MainActivity
Launchable-Activity: true
Permissions: android.permission.INTERNET

res/drawable/icon-192.png
[Linknet Fiber Logo - 192x192 pixels - Blue and white design with "LF" text]

classes.dex
[Android bytecode for Linknet Fiber app - Main activity with internet connectivity]

AndroidManifest.xml
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.linknet.fiber"
    android:versionCode="1"
    android:versionName="1.0">
    
    <application
        android:label="Linknet Fiber"
        android:icon="@drawable/icon_192"
        android:theme="@style/AppTheme"
        android:allowBackup="true">
        
        <activity
            android:name=".MainActivity"
            android:label="Linknet Fiber"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <uses-permission android:name="android.permission.INTERNET" />
    </application>
</manifest>

resources.arsc
[Android app resources - String values for Linknet Fiber branding]
